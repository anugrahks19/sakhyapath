# Set this in your shell. Do not put a real key into source control.
SAKHYAPATH_OPERATOR_KEY=replace-with-a-long-random-local-key
# Optional: actual Sentinel origin, only when authorised access is provided.
SAKHYAPATH_SENTINEL_BASE_URL=
# Optional: full Authorization header value supplied for the authorised portal.
SAKHYAPATH_SENTINEL_AUTHORIZATION=
# 1 behind HTTPS; 0 only for local HTTP demo.
SAKHYAPATH_COOKIE_SECURE=0
# Module 2: keep evidence and downloaded model files in private server storage.
SAKHYAPATH_EVIDENCE_DIR=
SAKHYAPATH_MODELS_DIR=
# A conservative local concurrency cap until actual feed/model capacity is measured.
SAKHYAPATH_ANALYTICS_MAX_CAMERAS=4
# Optional Windows CUDA/cuDNN DLL directory for onnxruntime-gpu.
SAKHYAPATH_CUDA_DLL_DIR=
# Optional Module 3 department-scoped reviewer keys, keyed by exact camera department.
SAKHYAPATH_DEPARTMENT_KEYS={}
