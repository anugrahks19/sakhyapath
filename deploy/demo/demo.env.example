# Copy to /etc/sakhyapath/demo.env on the VM. Restrict it to root (mode 0600).
# Generate a long random key; never commit its real value.
SAKHYAPATH_OPERATOR_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
SAKHYAPATH_COOKIE_SECURE=1

# These paths must be persistent and writable by the sakhyapath service user.
SAKHYAPATH_DB=/var/lib/sakhyapath/sakhyapath.sqlite3
SAKHYAPATH_EVIDENCE_DIR=/var/lib/sakhyapath/evidence
SAKHYAPATH_MODELS_DIR=/var/lib/sakhyapath/models
SAKHYAPATH_PROOF_KEY_PATH=/var/lib/sakhyapath/proof_signing_ed25519.pem
SAKHYAPATH_ANALYTICS_MAX_CAMERAS=4

# Add only when the organiser has supplied authorised access and feed policy.
# SAKHYAPATH_SENTINEL_BASE_URL=
# SAKHYAPATH_SENTINEL_AUTHORIZATION=

# Optional regional agents require separate processes, databases and tokens.
# SAKHYAPATH_REGIONS=[]
